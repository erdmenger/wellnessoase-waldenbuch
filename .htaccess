# Kompression und Caching. Jeder Block ist mit IfModule abgesichert:
# fehlt das Modul beim Hoster, wird er ignoriert (kein Serverfehler).

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/gif  "access plus 1 month"
  # CSS/JS tragen keine Versionsnummer im Namen, daher nur kurz cachen
  ExpiresByType text/css   "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>
